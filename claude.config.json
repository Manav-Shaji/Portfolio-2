{
  "schemaVersion": 1,
  "project": {
    "name": "Portfolio",
    "type": "nextjs-app",
    "description": "Premium developer portfolio built with Next.js App Router"
  },
  "architecture": {
    "stack": ["Next.js 15", "React 19", "TypeScript", "Tailwind CSS"],
    "router": "App Router",
    "styleSystem": "Tailwind CSS",
    "animation": ["GSAP", "Framer Motion"],
    "design": {
      "premiumCinematic": true,
      "responsive": true,
      "accessibility": true,
      "performanceOptimized": true
    }
  },
  "worktreeMapping": {
    "orchestrator": "claude",
    "codex": "worker/codex-portfolio",
    "opencode": "worker/opencode-portfolio",
    "qwen": "worker/qwen-portfolio",
    "mimo": "worker/mimo-portfolio",
    "atom": "worker/atom-portfolio"
  },
  "sharedFiles": [
    "package.json",
    "tsconfig.json",
    "tailwind.config.js",
    "next.config.js",
    "postcss.config.js",
    "src/styles/globals.css",
    "src/app/layout.tsx"
  ],
  "rules": [
    "No hardcoded secrets",
    "All user inputs validated",
    "TypeScript strict mode enforced",
    "Accessibility WCAG 2.1 AA compliant",
    "Mobile-first responsive design",
    "Premium cinematic motion with GSAP/Framer Motion",
    "No real professional information - fiction only"
  ]
}